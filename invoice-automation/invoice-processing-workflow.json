    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"qwen2.5:3b\",\n  stream: false,\n  options: { temperature: 0 },\n  format: {\n    type: \"object\",\n    properties: {\n      vendor: { type: [\"string\", \"null\"] },\n      invoice_number: { type: [\"string\", \"null\"] },\n      invoice_date: { type: [\"string\", \"null\"] },\n      currency: { type: [\"string\", \"null\"] },\n      total: { type: [\"number\", \"null\"] },\n      line_items: {\n        type: \"array\",\n        items: {\n          type: \"object\",\n          properties: {\n            description: { type: \"string\" },\n            quantity: { type: \"number\" },\n            unit_price: { type: \"number\" },\n            amount: { type: \"number\" }\n          },\n          required: [\"description\", \"quantity\", \"unit_price\", \"amount\"]\n        }\n      }\n    },\n    required: [\"vendor\", \"invoice_number\", \"invoice_date\", \"currency\", \"total\", \"line_items\"]\n  },\n  messages: [\n    {\n      role: \"system\",\n      content: \"You extract data from invoice text. Return JSON only.\\n\\nRules:\\n- vendor: the company that issued the invoice (the name at the top), not the 'Bill To' client.\\n- invoice_number: the code labeled Invoice No, Invoice #, Invoice ID, Bill No, or Ref. Copy it exactly. It must contain at least one digit. The heading word INVOICE is not an invoice number. If no labeled number is present, use null.\\n- invoice_date: always format as YYYY-MM-DD. Dates written like 12/08/2026 are DD/MM/YYYY (day first).\\n- currency: 3-letter code. A $ sign means USD. A plain P or ₱ before amounts means PHP. The text PHP means PHP.\\n- total: the final amount due, as a plain number with no currency symbol or commas. Copy the printed total. Do not calculate it yourself.\\n- line_items: every row in the item table. Numbers only, no currency symbols or commas.\\n- If a field is not present in the text, use null. Never guess or invent a value.\"\n    },\n    { role: \"user\", content: $json.text }\n  ]\n}) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "id": "cb0c6b42-88a3-4dca-8233-7665e1cf3816",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.message.content;\nlet data;\ntry {\n  data = JSON.parse(raw);\n} catch (e) {\n  data = { parse_error: true, raw_output: raw };\n}\nreturn [{ json: data }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "e7d940c2-dcf7-46ba-b30c-db3b88f6596f",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const data = /** @type {any} */ ($input.first().json);\n\n// Get the original PDF's file name (works for both form and webhook)\nlet bin = {};\ntry { bin = $('Invoice Upload').first().binary || {}; } catch (e) {}\nif (!Object.keys(bin).length) {\n  try { bin = $('Webhook').first().binary || {}; } catch (e) {}\n}\nconst key = Object.keys(bin)[0];\nconst sourceFile = key ? bin[key].fileName : null;\n\nconst reasons = [];\n\n// Clean up empty or fake invoice numbers\nif (typeof data.invoice_number === 'string') {\n  data.invoice_number = data.invoice_number.trim();\n  if (data.invoice_number === '' || !/\\d/.test(data.invoice_number)) {\n    data.invoice_number = null;\n  }\n}\n\n// Invoice number must appear in the PDF right after an invoice label\nconst pdfText = ($('Extract from File').first().json.text) || '';\nif (data.invoice_number) {\n  const num = String(data.invoice_number);\n  const esc = num.replace(/[.*+?^${}()|[\\]\\\\\\/]/g, '\\\\$&');\n  const labelled = new RegExp(\n    '(invoice\\\\s*(no\\\\.?|#|id|number)|bill\\\\s*no\\\\.?|ref)\\\\s*[:#]?\\\\s*' + esc + '(?![\\\\w])', 'i'\n  );\n  if (!labelled.test(pdfText)) {\n    data.invoice_number = null;\n  }\n}\n\n// 1. Did the AI output break?\nif (data.parse_error) {\n  reasons.push('AI output could not be parsed');\n}\n\n// 2. Required fields present?\nconst required = ['vendor', 'invoice_number', 'invoice_date', 'currency', 'total'];\nfor (const f of required) {\n  if (data[f] === null || data[f] === undefined || data[f] === '') {\n    reasons.push(`missing ${f}`);\n  }\n}\n\n// 3. Date format check\nif (data.invoice_date && !/^\\d{4}-\\d{2}-\\d{2}$/.test(data.invoice_date)) {\n  reasons.push('invalid date format');\n}\n\n// 4. Do the line items add up to the total?\nconst items = Array.isArray(data.line_items) ? data.line_items : [];\nif (items.length === 0) {\n  reasons.push('no line items found');\n} else if (typeof data.total === 'number') {\n  const sum = items.reduce((s, i) => s + (Number(i.amount) || 0), 0);\n  const matchesPlain = Math.abs(sum - data.total) < 0.01;\n  const matchesVat = Math.abs(sum * 1.12 - data.total) < 0.01;\n  if (!matchesPlain && !matchesVat) {\n    reasons.push(`total ${data.total} does not match line items (${sum.toFixed(2)})`);\n  }\n}\n\n// 5. Unusually high total\nconst limits = { PHP: 100000, USD: 2000 };\nconst limit = limits[data.currency] || 100000;\nif (typeof data.total === 'number' && data.total > limit) {\n  reasons.push('unusually high total');\n}\n\nreturn [{\n  json: {\n    ...data,\n    source_file: sourceFile,\n    status: reasons.length ? 'needs_review' : 'filed',\n    review_reason: reasons.length ? reasons.join('; ') : null\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
